# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDEs and editors
/.idea
/.vscode
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# OS
Thumbs.db

# Temporary files
tmp/
temp/
.env

# Service account keys / secrets (never commit)
/secrets/

# Generated GA4 reports
/outputs/ga4-report-*.md
/outputs/ads-report-*.md

# Local Netlify folder
.netlify

# ローカル実行の副産物。⚠ ここを空けておくと `git add -A` で丸ごと入る
#   （logs/ には MCP のログが数百KB単位で溜まる）
logs/
cache/

# supabase CLI がローカルに作る作業ファイル（プロジェクト参照・接続URL・各種バージョン）
supabase/.temp/
