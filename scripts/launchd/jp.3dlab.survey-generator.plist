<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  アンケート設問の在庫を切らさないための定期実行。

  在庫が7問を下回っているときだけ生成するので、毎週動かしても無駄打ちにはならない。
  （survey-generator.sh の MIN_STOCK を参照）

  インストール:
    cp scripts/launchd/jp.3dlab.survey-generator.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/jp.3dlab.survey-generator.plist

  ⚠ ProgramArguments のパスは環境に合わせて書き換えること。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>jp.3dlab.survey-generator</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>/Users/yuho/Dev/3dworkshop/scripts/survey-generator.sh</string>
  </array>

  <!-- 毎週月曜 6:00 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/yuho/Library/Logs/3dworkshop/survey-generator.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yuho/Library/Logs/3dworkshop/survey-generator.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
