{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/daily-survey",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/purge-chat-logs",
      "schedule": "30 18 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/workshops/category/family-ai3d-printer-original-work",
      "destination": "/workshops/category/ai3d-printer-original-work-workshop",
      "statusCode": 301
    },
    {
      "source": "/blog/filament-dryer-recommended-2026",
      "destination": "/blog/filament-dryer-comparison-2026",
      "statusCode": 301
    },
    {
      "source": "/blog/filament-dryer-vs-drybox-guide-2026",
      "destination": "/blog/filament-dryer-comparison-2026",
      "statusCode": 301
    },
    {
      "source": "/blog/free-3d-model-sites-comparison-thingiverse-printables-makerworld-2026",
      "destination": "/blog/makerworld-printables-thingiverse-free-3d-model-sites-comparison-2026",
      "statusCode": 301
    },
    {
      "source": "/blog/printables-vs-thingiverse-vs-makerworld-comparison-2026",
      "destination": "/blog/makerworld-printables-thingiverse-free-3d-model-sites-comparison-2026",
      "statusCode": 301
    },
    {
      "source": "/blog/sla-resin-guide-2026",
      "destination": "/blog/3d-printer-resin-comparison-guide-2026",
      "statusCode": 301
    },
    {
      "source": "/blog/sla-resin-types-guide",
      "destination": "/blog/3d-printer-resin-comparison-guide-2026",
      "statusCode": 301
    },
    {
      "source": "/blog/next-gen-3d-printer-expo-osaka-2026-autumn-highlights",
      "destination": "/blog/next-gen-3d-printer-expo-osaka-2026-guide",
      "statusCode": 301
    },
    {
      "source": "/blog/3d-printer-useful-items-10",
      "destination": "/blog/3d-printer-useful-goods-20",
      "statusCode": 301
    },
    {
      "source": "/blog/orcaslicer-2-4-new-features-guide-2026",
      "destination": "/blog/orcaslicer-2-4-guide-orca-cloud-zaa-profile-sync",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(favicon.ico|logo.png|hero-bg.jpg|og-image.jpg|staff-both.jpg|staff-ito-yu-headshot.jpg|staff-ito-yu-workshop.jpg|staff-ito-yu.jpg|staff-ito-yuho-avif.avif|staff-ito-yuho-headshot.webp|staff-ito-yuho-workshop.jpg|staff-ito-yuho.jpg|staff-workshop-scene.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/media-coverage/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/offline.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
