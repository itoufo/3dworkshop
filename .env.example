# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Application
# 開発環境: http://localhost:3000
# 本番環境: https://3dlab.jp
# サイトマップ生成にも使用されます
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Analytics 4 (gtag.js) — 未設定時は G-HWRY2Z7G7N にフォールバック
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-HWRY2Z7G7N

# GA4 Data API (scripts/ga4-report.ts で使用 / サーバー側のみ)
# kpi-hub の OAuth を流用（サービスアカウント不要）。kpi-hub/.env.local からコピー
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# 任意: 数値プロパティ ID を明示（未設定なら measurement ID から自動解決。3dlab=514194460）
# GA4_PROPERTY_ID=514194460

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=noreply@3dlab.jp

# Event Platform Credentials (for auto-posting)
STREET_ACADEMY_EMAIL=
STREET_ACADEMY_PASSWORD=
AINI_EMAIL=
AINI_PASSWORD=
KOKUCHPRO_EMAIL=
KOKUCHPRO_PASSWORD=
PEATIX_EMAIL=
PEATIX_PASSWORD=
IKOYO_EMAIL=
IKOYO_PASSWORD=
CONNPASS_EMAIL=
CONNPASS_PASSWORD=