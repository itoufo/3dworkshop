# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 管理画面
# /admin のログインパスワード。書き込み API の署名鍵も兼ねる（lib/admin-auth.ts）
# ⚠ 変更すると、ログイン中の管理者は全員ログインし直しになる
ADMIN_PASSWORD=

# チャットボット（/api/chat と 管理画面 /admin/chat-knowledge）
# ⚠ 未設定でもサイトは動く。チャットだけが「準備中」を返す
OPENAI_API_KEY=
# 任意。既定は gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# 任意。既定は text-embedding-3-small
# ⚠ 変えたら 管理画面の「ベクトルを作り直す」を実行すること（既存の埋め込みと混ざると検索が壊れる）
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 任意。チャットの返答に付ける署名の鍵（クライアントが偽の「AIの発言」を混ぜるのを防ぐ）
# 未設定なら SUPABASE_SERVICE_ROLE_KEY を使う。ふつうは設定しなくてよい
# ⚠ 設定するなら全インスタンスで同じ値にすること。ばらつくと会話の履歴が毎回捨てられる
CHAT_SIGNING_SECRET=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Application
# 開発環境: http://localhost:3000
# 本番環境: https://3dlab.jp
# サイトマップ生成にも使用されます
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Analytics 4 (gtag.js) — 未設定時は G-HWRY2Z7G7N にフォールバック
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-HWRY2Z7G7N

# GA4 Data API (scripts/ga4-report.ts で使用 / サーバー側のみ)
# kpi-hub の OAuth を流用（サービスアカウント不要）。kpi-hub/.env.local からコピー
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# 任意: 数値プロパティ ID を明示（未設定なら measurement ID から自動解決。3dlab=514194460）
# GA4_PROPERTY_ID=514194460

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=noreply@3dlab.jp

# Event Platform Credentials (for auto-posting)
STREET_ACADEMY_EMAIL=
STREET_ACADEMY_PASSWORD=
AINI_EMAIL=
AINI_PASSWORD=
KOKUCHPRO_EMAIL=
KOKUCHPRO_PASSWORD=
PEATIX_EMAIL=
PEATIX_PASSWORD=
IKOYO_EMAIL=
IKOYO_PASSWORD=
CONNPASS_EMAIL=
CONNPASS_PASSWORD=
# ===== Web Push (PWA 通知) =====
# 鍵の生成: node -e "console.log(require('web-push').generateVAPIDKeys())"
# 未設定でもサイトは動くが、日程を追加しても通知は送信されない
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:y-sato@sunu25.com
